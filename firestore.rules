rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function sessioIniciada() {
      return request.auth != null;
    }

    function nomValid(nom) {
      return nom is string
        && nom == nom.trim()
        && nom.size() > 0
        && nom.size() <= 80;
    }

    function esMembre(llistaId) {
      return sessioIniciada()
        && request.auth.uid in
          get(/databases/$(database)/documents/llistes/$(llistaId)).data.membres;
    }

    function llistaNovaValida() {
      let dades = request.resource.data;

      return dades.keys().hasAll([
          'nom', 'propietariId', 'membres', 'creadaEl'
        ])
        && dades.keys().hasOnly([
          'nom', 'propietariId', 'membres', 'creadaEl'
        ])
        && nomValid(dades.nom)
        && dades.propietariId == request.auth.uid
        && dades.membres is list
        && dades.membres == [request.auth.uid]
        && dades.creadaEl == request.time;
    }

    function categoriaValida() {
      let dades = request.resource.data;

      return dades.keys().hasAll(['nom', 'creadaEl'])
        && dades.keys().hasOnly(['nom', 'creadaEl'])
        && nomValid(dades.nom)
        && dades.creadaEl is timestamp;
    }

    match /llistes/{llistaId} {
      allow create: if sessioIniciada()
                    && llistaNovaValida();

      allow read: if sessioIniciada()
                  && request.auth.uid in resource.data.membres;

      allow update, delete: if false;

      match /categories/{categoriaId} {
        allow read: if esMembre(llistaId);

        allow create: if esMembre(llistaId)
                      && categoriaValida()
                      && request.resource.data.creadaEl == request.time;

        // En editar una categoria només es pot canviar el nom.
        allow update: if esMembre(llistaId)
                      && categoriaValida()
                      && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['nom']);

        allow delete: if esMembre(llistaId);
      }
    }
  }
}