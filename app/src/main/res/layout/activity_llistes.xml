<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arrelLlistes"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/les_meves_llistes"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNomLlista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/nom_llista"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:minHeight="48dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnCrearLlista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/crear_llista" />

        <Button
            android:id="@+id/btnMeuCodi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compartir_meu_codi" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compartir_instruccio" />

        <TextView
            android:id="@+id/tvEstatLlistes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/carregant_llistes" />

        <ListView
            android:id="@+id/lvLlistes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnTornar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tornar" />

    </LinearLayout>
</FrameLayout>